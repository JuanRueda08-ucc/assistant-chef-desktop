{
  "name": "assistant-chef-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Chef digital: asistente culinario de escritorio con voz, temporizadores y avatar",
  "main": "./out/main/index.js",
  "author": "Juan José Rueda",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:server && npm run svelte-check",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run voz:preparar && npm run build && electron-builder --dir",
    "build:win": "npm run voz:preparar && npm run build && electron-builder --win",
    "build:mac": "npm run voz:preparar -- darwin-x64 && npm run voz:preparar -- darwin-arm64 && npm run build && electron-builder --mac",
    "build:linux": "npm run voz:preparar -- linux-x64 && npm run voz:preparar -- linux-arm64 && npm run build && electron-builder --linux",
    "server:dev": "tsx watch --tsconfig tsconfig.server.json server/src/principal.ts",
    "server:start": "tsx --tsconfig tsconfig.server.json server/src/principal.ts",
    "voz:preparar": "node tools/preparar-voz.mjs",
    "voz:verificar": "node tools/verificar-voz.cjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.3",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
