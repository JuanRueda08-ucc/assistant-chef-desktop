# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Proveedor de IA que usa server/ (por ejemplo: anthropic, openai). Solo lo lee el backend.
PROVEEDOR_IA=
# Clave de la API del proveedor. Solo en el backend, nunca en el cliente.
PROVEEDOR_IA_API_KEY=
# URL del backend mínimo (server/) que usa la app de escritorio.
CHEF_API_URL=http://localhost:8787
