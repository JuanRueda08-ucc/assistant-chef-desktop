# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# --- Backend (server/) ------------------------------------------------------------------------
# Proveedor de IA y de voz: "falso" (sin red ni clave) o "gemini" (Google AI Studio).
PROVEEDOR_IA=falso
# Clave de la API del proveedor. Solo en el backend, nunca en el cliente.
PROVEEDOR_IA_API_KEY=
# Puerto del servidor local (npm run server:dev).
SERVIDOR_PUERTO=8787
# Peticiones por cuenta y día (opcional; por defecto 40, 20, 60 y 120).
LIMITE_VOZ=
LIMITE_RECETAS=
LIMITE_SUSTITUCIONES=
LIMITE_CHAT=

# --- Cuentas (Better Auth, decisión 0016) ---------------------------------------------------
# Obligatorio: secreto de al menos 32 caracteres. Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública del backend (por defecto http://localhost:SERVIDOR_PUERTO).
BETTER_AUTH_URL=
# Base de datos de cuentas del backend (por defecto .datos/cuentas.sqlite, fuera de Git).
CUENTAS_DB=
# Correo para los códigos. Sin SMTP_HOST, en desarrollo los códigos salen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- App de escritorio -------------------------------------------------------------------------
# URL del backend mínimo que usa la app.
CHEF_API_URL=http://localhost:8787
